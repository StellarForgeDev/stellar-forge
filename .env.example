# Stellar-Forge environment variables (example)
#
# Copy this file to `.env` and adjust values only if you need to override the
# built-in defaults. All variables are OPTIONAL; the application ships with
# working defaults for Stellar Testnet and Futurenet.
#
# Do NOT commit real secrets or credentials. This file contains no secrets.

# Override the default Stellar Testnet RPC endpoint used by transaction
# preparation/submission. Consumed in src/lib/transactions/rpc.ts.
# Defaults to https://soroban-testnet.stellar.org when unset.
STELLAR_RPC_TESTNET_URL=

# Override the default Stellar Futurenet RPC endpoint used by transaction
# preparation/submission. Consumed in src/lib/transactions/rpc.ts.
# Defaults to https://rpc-futurenet.stellar.org when unset.
STELLAR_RPC_FUTURENET_URL=
