{
  "name": "stellar-forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-sandbox-runner.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox:build": "node scripts/sandbox-build.mjs",
    "verify:prebuilt": "node scripts/verify-prebuilt.mjs",
    "verify:testnet": "node --experimental-strip-types scripts/verify-testnet-artifacts.ts",
    "generate:prebuilt-metadata": "node scripts/verify-prebuilt.mjs --generate",
    "vercel-build": "pnpm run build"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
